# 复制到 .env 并填入密钥。运行脚本时用 --provider / --model 选择其一（见 README）。

# === 遇 429 速率限制时自动退避重试（可选；仅对 chat.completions 生效）===
# LLM_429_MAX_RETRIES=8
# LLM_429_BACKOFF_BASE_SEC=2.0
# LLM_429_BACKOFF_MAX_SEC=120.0
#
# === GLM-4 专用（DeepSeek / GLM-5 不受影响）：更紧工具回传截断 + 步间小延迟；429 退避在未设置上面三项时默认更温和 ===
# GLM4_INTER_STEP_SLEEP_SEC=0.85
# GLM4_TOOL_TRUNC_THRESHOLD=3500
# GLM4_TOOL_TRUNC_EACH=1600

# === 并行双厂商（推荐）：DeepSeek + 智谱 GLM ===
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
#
# GLM_API_KEY=
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_MODEL=glm-4-flash

# === Claude（须为 OpenAI 兼容 Chat Completions 网关；base 常需含 /v1）===
# CLAUDE_API_KEY=
# CLAUDE_BASE_URL=https://example.com/v1
# CLAUDE_MODEL=claude-sonnet-4-20250514

# === 单一配置（兼容旧版）：任意 OpenAI 兼容端点 ===
# LLM_API_KEY=your_api_key_here
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# === 硅基流动（推荐独立变量名，与 DeepSeek/GLM 并存）===
# SILICON_API_KEY=
# SILICON_BASE_URL=https://api.siliconflow.cn
# SILICON_MODEL=MiniMaxAI/MiniMax-M2.5
#
# 运行：python meta_benchmark/run_new_scenarios.py --letter a --provider silicon --results-dir meta_runs
# （可省略 --model，则用 SILICON_MODEL）

# === 其他兼容端点示例：硅基流动 + Kimi（单一 LLM_*）===
# LLM_API_KEY=your_siliconflow_api_key
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=moonshotai/Kimi-K2-Thinking
