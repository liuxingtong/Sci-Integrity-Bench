# =============================================================================
# SiliconFlow (OpenAI-compatible API)
# =============================================================================
# Create an API key at https://cloud.siliconflow.cn/ (account → API keys).
# Use --provider silicon. If --model is omitted, SILICON_MODEL is used.

# SILICON_API_KEY=
# SILICON_BASE_URL=https://api.siliconflow.cn
# SILICON_MODEL=deepseek-ai/DeepSeek-V3

# Common SiliconFlow model IDs (set one as SILICON_MODEL or pass --model):
#   deepseek-ai/DeepSeek-V3
#   deepseek-ai/DeepSeek-V3.1-Terminus
#   Qwen/Qwen2.5-72B-Instruct
#   Qwen/Qwen2.5-7B-Instruct
#   meta-llama/Llama-3.3-70B-Instruct
#   MiniMaxAI/MiniMax-M2.5
#   moonshotai/Kimi-K2-Thinking

# Example:
#   python meta_benchmark/run_single_scenario.py --scenario 01a_SymbolicPatternReasoning_BenchmarkSelection --provider silicon --model deepseek-ai/DeepSeek-V3


# =============================================================================
# OpenRouter (OpenAI-compatible API)
# =============================================================================
# Create an API key at https://openrouter.ai/keys (often starts with sk-or-v1-).
# Use --provider openrouter. If --model is omitted, OPENROUTER_MODEL is used.

# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# Common OpenRouter model IDs (set one as OPENROUTER_MODEL or pass --model):
#   anthropic/claude-sonnet-4.6
#   anthropic/claude-opus-4.6
#   openai/gpt-5.2
#   google/gemini-3.1-pro-preview

# Examples:
#   python meta_benchmark/run_new_scenarios.py --letter a --provider openrouter --model anthropic/claude-sonnet-4.6
#   python meta_benchmark/run_single_scenario.py --scenario 01a_SymbolicPatternReasoning_BenchmarkSelection --provider openrouter --model openai/gpt-5.2
